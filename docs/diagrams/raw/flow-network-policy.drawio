<mxfile title="Flow: enforcing one namespace&#x27;s network policy on kube-router" layout="[{&quot;layout&quot;:&quot;elkLayered&quot;,&quot;config&quot;:{&quot;elk.layered.crossingMinimization.forceNodeModelOrder&quot;:true,&quot;elk.direction&quot;:&quot;DOWN&quot;,&quot;elk.spacing.nodeNode&quot;:40,&quot;elk.layered.spacing.nodeNodeBetweenLayers&quot;:60,&quot;elk.spacing.edgeLabel&quot;:6,&quot;elk.layered.nodePlacement.strategy&quot;:&quot;NETWORK_SIMPLEX&quot;,&quot;elk.layered.considerModelOrder.strategy&quot;:&quot;NODES_AND_EDGES&quot;,&quot;elk.hierarchyHandling&quot;:&quot;INCLUDE_CHILDREN&quot;,&quot;elk.nodeSize.constraints&quot;:&quot;&quot;,&quot;edgeStyle&quot;:&quot;orthogonal&quot;,&quot;corners&quot;:&quot;rounded&quot;}}]"><diagram name="flow-network-policy"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="least-connected namespace, named by the estate instance" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#f5f5f5,#2b2b2b);strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="240" height="66" as="geometry"/></mxCell><mxCell id="rback" value="declare the rollback: written beside the enforced mark, before enforcement" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#ffe6cc,#4a3820);strokeColor=light-dark(#d79b00,#d9a050);" vertex="1" parent="1"><mxGeometry width="240" height="86" as="geometry"/></mxCell><mxCell id="enforce" value="the Project&#x27;s render applies the namespace&#x27;s NetworkPolicy objects; kube-router enforces at once" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#dae8fc,#1f3a5f);strokeColor=light-dark(#6c8ebf,#7aa7e0);" vertex="1" parent="1"><mxGeometry width="240" height="106" as="geometry"/></mxCell><mxCell id="window" value="window of at least 14 days: normal traffic, a backup, a restore, a maintenance window" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#dae8fc,#1f3a5f);strokeColor=light-dark(#6c8ebf,#7aa7e0);" vertex="1" parent="1"><mxGeometry width="240" height="106" as="geometry"/></mxCell><mxCell id="q" value="an undeclared flow surfaces?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#f5f5f5,#2b2b2b);strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="260" height="90" as="geometry"/></mxCell><mxCell id="rollback" value="the flow becomes an edge in the model; the rollback holds the namespace until the fix&#x27;s render lands, and the window starts again" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#ffe6cc,#4a3820);strokeColor=light-dark(#d79b00,#d9a050);" vertex="1" parent="1"><mxGeometry width="240" height="126" as="geometry"/></mxCell><mxCell id="stays" value="the namespace keeps its enforced mark; the next namespace&#x27;s window opens" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#d5e8d4,#21402a);strokeColor=light-dark(#82b366,#7fc08c);" vertex="1" parent="1"><mxGeometry width="240" height="86" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="start" target="rback"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="rback" target="enforce"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="enforce" target="window"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="window" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="yes: a cut, an incident or a failing check" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="q" target="rollback"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="no" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="q" target="stays"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
