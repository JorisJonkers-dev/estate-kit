<mxfile title="Flow: how one render applies as a chain of Kustomizations, and what pruning never touches" layout="[{&quot;layout&quot;:&quot;elkLayered&quot;,&quot;config&quot;:{&quot;elk.layered.crossingMinimization.forceNodeModelOrder&quot;:true,&quot;elk.direction&quot;:&quot;DOWN&quot;,&quot;elk.spacing.nodeNode&quot;:40,&quot;elk.layered.spacing.nodeNodeBetweenLayers&quot;:60,&quot;elk.spacing.edgeLabel&quot;:6,&quot;elk.layered.nodePlacement.strategy&quot;:&quot;NETWORK_SIMPLEX&quot;,&quot;elk.layered.considerModelOrder.strategy&quot;:&quot;NODES_AND_EDGES&quot;,&quot;elk.hierarchyHandling&quot;:&quot;INCLUDE_CHILDREN&quot;,&quot;elk.nodeSize.constraints&quot;:&quot;&quot;,&quot;edgeStyle&quot;:&quot;orthogonal&quot;,&quot;corners&quot;:&quot;rounded&quot;}}]"><diagram name="flow-apply-chain"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="the render is published; Flux reconciles its chain" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#f5f5f5,#2b2b2b);strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="240" height="66" as="geometry"/></mxCell><mxCell id="newkind" value="the render introduces a kind or namespace?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#f5f5f5,#2b2b2b);strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="260" height="90" as="geometry"/></mxCell><mxCell id="stage1" value="stage 1: the chain without the objects Unverifiable by construction" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#ffe6cc,#4a3820);strokeColor=light-dark(#d79b00,#d9a050);" vertex="1" parent="1"><mxGeometry width="240" height="86" as="geometry"/></mxCell><mxCell id="stage2" value="the API server 