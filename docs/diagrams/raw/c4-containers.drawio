<mxfile title="C4 level 2: estate-kit&#x27;s containers and the protocol on each edge" layout="[{&quot;layout&quot;:&quot;elkLayered&quot;,&quot;config&quot;:{&quot;elk.layered.crossingMinimization.forceNodeModelOrder&quot;:true,&quot;elk.direction&quot;:&quot;DOWN&quot;,&quot;elk.spacing.nodeNode&quot;:40,&quot;elk.layered.spacing.nodeNodeBetweenLayers&quot;:110,&quot;elk.spacing.edgeLabel&quot;:6,&quot;elk.layered.nodePlacement.strategy&quot;:&quot;NETWORK_SIMPLEX&quot;,&quot;elk.layered.considerModelOrder.strategy&quot;:&quot;NODES_AND_EDGES&quot;,&quot;elk.hierarchyHandling&quot;:&quot;INCLUDE_CHILDREN&quot;,&quot;elk.nodeSize.constraints&quot;:&quot;&quot;,&quot;edgeStyle&quot;:&quot;orthogonal&quot;,&quot;corners&quot;:&quot;rounded&quot;}}]"><diagram name="c4-containers"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ci" value="&lt;b&gt;Project CI&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div&gt;A GitHub Actions deploy job&lt;/div&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=bottom;spacingBottom=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry width="200" height="170" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;Operator&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div&gt;In a browser&lt;/div&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=bottom;spacingBottom=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry width="200" height="170" as="geometry"/></mxCell><mxCell id="ek" value="estate-kit" style="swimlane;startSize=30;rounded=1;arcSize=4;absoluteArcSize=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fontStyle=1;fillColor=none;swimlaneFillColor=none;strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="300" height="200" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;estate-kit CLI&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Rust, one binary]&lt;/div&gt;&lt;div&gt;Validates and plans offline&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="ek"><mxGeometry width="240" height="120" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;UI&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Vue, embedded in Observation]&lt;/div&gt;&lt;div&gt;Rollouts, Projects, hosts&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="ek"><mxGeometry width="240" height="120" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;Observation&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Rust, its own binary and Deployment]&lt;/div&gt;&lt;div&gt;Read-only views of what runs; creates and expires Silences&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="ek"><mxGeometry width="240" height="120" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;service&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Rust, links the compiler]&lt;/div&gt;&lt;div&gt;Composes, dry-runs, signs, streams rollouts, runs the Release Gate&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="ek"><mxGeometry width="240" height="120" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;event log&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: platform-postgres]&lt;/div&gt;&lt;div&gt;Append-only rollout events&lt;/div&gt;" style="shape=cylinder3;size=12;boundedLbl=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="ek"><mxGeometry width="240" height="130" as="geometry"/></mxCell><mxCell id="applier" value="&lt;b&gt;host applier&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Rust, systemd]&lt;/div&gt;&lt;div&gt;Switches one node at a time&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="ek"><mxGeometry width="240" height="120" as="geometry"/></mxCell><mxCell id="comps" value="&lt;b&gt;components&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Rust, one image each]&lt;/div&gt;&lt;div&gt;Six reconcilers: migrations, secret grants, database and bucket catalogs, backups, Mailboxes&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="ek"><mxGeometry width="240" height="120" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Kubernetes API&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;div&gt;Dry-runs and status&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=center;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry width="240" height="120" as="geometry"/></mxCell><mxCell id="ghcr" value="&lt;b&gt;ghcr&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;div&gt;Fragments, renders, tags&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;