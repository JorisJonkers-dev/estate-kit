%% title: Rust: the types that cross the pipeline's seams
classDiagram
    direction TB
    class PinnedInputSet {
        fragments: BTreeMap#lt;ProjectName, Pinned#lt;ProjectIntent#gt;#gt;
        platform: Pinned#lt;PlatformIntent#gt;
        cluster_state: Pinned#lt;ClusterState#gt;
        render_key(project) RenderKey
    }
    class Hasher {
        <<trait>>
        digest(bytes) Digest
    }
    class ResolvedDeployment {
        applications: BTreeMap#lt;ApplicationId, ResolvedApplication#gt;
        trace: Trace
    }
    class Renderer {
        <<trait>>
        render(ResolvedDeployment) Result#lt;Vec#lt;Deliverable#gt;, Vec#lt;Diagnostic#gt;#gt;
        declared in the deliverable crate
    }
    class Deliverable {
        path: OutputPath
        owner: ProjectName
        object: DeliverableObject
        provenance: BTreeMap#lt;FieldPath, ElementRef#gt;
    }
    class Diagnostic {
        code: Code
        severity: Severity
        primary: Location
        related: Vec#lt;Related#gt;
        message: String
        help: String
    }
    class Location {
        <<enum>>
        Document: SourceId, ModelPath
        Fact: FactKey
        generic, in diagnostics, model-intent builds it
    }
    class Related {
        location: Location
        label: String
    }
    class ElementRef {
        project: ProjectName
        element: names, by identity
        field: Option#lt;FieldName#gt;
        to_model_path(Document) ModelPath
        defined in model-intent
    }
    PinnedInputSet ..> Hasher : digests through
    Renderer ..> ResolvedDeployment : reads
    Renderer ..> Deliverable : emits
    Renderer ..> Diagnostic : or reports
    Diagnostic --> Location : primary at
    Diagnostic *-- "0..*" Related
    Related --> Location : at
    Deliverable --> ElementRef : traces each field to
    classDef accent fill:#0000a1,stroke:#0000b1
    classDef data fill:#0000a2,stroke:#0000b2
    class Hasher:::accent
    class Renderer:::accent
    class ElementRef:::data
    class Location:::data
