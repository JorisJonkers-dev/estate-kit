<mxfile title="Recovery: how each store is captured, and where the copies live" layout="[{&quot;layout&quot;:&quot;elkLayered&quot;,&quot;config&quot;:{&quot;elk.layered.crossingMinimization.forceNodeModelOrder&quot;:true,&quot;elk.direction&quot;:&quot;DOWN&quot;,&quot;elk.spacing.nodeNode&quot;:40,&quot;elk.layered.spacing.nodeNodeBetweenLayers&quot;:70,&quot;elk.spacing.edgeLabel&quot;:6,&quot;elk.layered.nodePlacement.strategy&quot;:&quot;NETWORK_SIMPLEX&quot;,&quot;elk.layered.considerModelOrder.strategy&quot;:&quot;NODES_AND_EDGES&quot;,&quot;elk.hierarchyHandling&quot;:&quot;INCLUDE_CHILDREN&quot;,&quot;elk.nodeSize.constraints&quot;:&quot;&quot;,&quot;edgeStyle&quot;:&quot;orthogonal&quot;,&quot;corners&quot;:&quot;rounded&quot;}}]"><diagram name="recovery"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cluster" value="«execution environment» Kubernetes cluster" style="swimlane;startSize=30;rounded=1;arcSize=4;absoluteArcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fontStyle=1;fillColor=none;swimlaneFillColor=none;strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="300" height="200" as="geometry"/></mxCell><mxCell id="ds" value="k3s datastore" style="shape=cylinder3;size=10;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="cluster"><mxGeometry width="150" height="74" as="geometry"/></mxCell><mxCell id="pg" value="platform-postgres: event log, job table, Tenant operation log" style="shape=cylinder3;size=10;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="cluster"><mxGeometry width="240" height="114" as="geometry"/></mxCell><mxCell id="dbs" value="Project databases, one per Environment" style="shape=cylinder3;size=10;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="cluster"><mxGeometry width="240" height="94" as="geometry"/></mxCell><mxCell id="vol" value="local-path volumes other than Postgres" style="shape=cylinder3;size=10;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="cluster"><mxGeometry width="240" height="94" as="geometry"/></mxCell><mxCell id="vault" value="Vault" style="shape=cylinder3;size=10;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="cluster"><mxGeometry width="150" height="74" as="geometry"/></mxCell><mxCell id="backupc" value="backup component" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#dae8fc,#1f3a5f);strokeColor=light-dark(#6c8ebf,#7aa7e0);" vertex="1" parent="cluster"><mxGeometry width="161" height="56" as="geometry"/></mxCell><mxCell id="provider" value="«device» EU-controlled provider" style="swimlane;startSize=30;rounded=1;arcSize=4;absoluteArcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fontStyle=1;fillColor=none;swimlaneFillColor=none;strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="300" height="200" as="geometry"/></mxCell><mxCell id="kopia" value="Kopia repository, one per Environment: Tenant exports, volume contents; 30-day COMPLIANCE lock on every object" style="shape=cylinder3;size=10;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="provider"><mxGeometry width="240" height="134" as="geometry"/></mxCell><mxCell id="pgbr" value="pgBackRest repository, one per Environment: base backups (7 daily, 4 weekly, 6 monthly) plus the WAL archive; every object 30-day COMPLIANCE locked" style="shape=cylinder3;size=10;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="provider"><mxGeometry width="240" height="174" as="geometry"/></mxCell><mxCell id="fleet" value="fleet-infra" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#eeeeee,#303030);strokeColor=light-dark(#999999,#8a8a8a);" vertex="1" parent="1"><mxGeometry width="160" height="56" as="geometry"/></mxCell><mxCell id="probe" value="WAL archive freshness check: fails when no WAL object is under 15 minutes old, or the newest has under 7 days of its 30-day lock left" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#f5f5f5,#2b2b2b);strokeColor=light-dark(#666666,#a8a8a8);" vertex="1" parent="1"><mxGeometry width="240" height="126" as="geometry"/></mxCell><mxCell id="open" value="No datastore backup is written today: the open item datastore backup, due 2027-04-30" style="shape=note;size=14;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=light-dark(#1a1a1a,#e8e8e8);fillColor=light-dark(#fff2cc,#3a3220);strokeColor=light-dark(#d6b656,#c9a74a);" vertex="1" parent="1"><mxGeometry width="240" height="86" as="geometry"/></mxCell><mxCell id="e1" value="fleet-infra&#x27;s to write; excluded from the drill until it exists" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=none;" edge="1" parent="1" source="ds" target="open"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="pgBackRest: base backups plus WAL archived continuously, segment every 5 minutes" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="pg" target="backupc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="pgBackRest: base backups plus WAL archived continuously" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="dbs" target="backupc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="a daily snapshot" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="vol" target="backupc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="writes Tenant exports and volume snapshots; writer key writes, never deletes a version or shortens a lock" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="backupc" target="kopia"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="writes base backups and WAL; writer key writes, never deletes a version or shortens a lock" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="backupc" target="pgbr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="reads each object&#x27;s age and remaining lock" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=none;" edge="1" parent="1" source="probe" target="pgbr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="a raft snapshot every 6 hours, with an off-cluster copy" style="html=1;rounded=1;fontFamily=Helvetica;fontSize=14;fontSize=12;fontColor=light-dark(#1a1a1a,#e8e8e8);strokeColor=light-dark(#666666,#a8a8a8);labelBackgroundColor=light-dark(#ffffff,#1e1e1e);endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="fleet" target="vault"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
