%% title: Go: the rollout core and the ports it drives
classDiagram
    direction TB
    class Rollout {
        ID, Project, Fragment
        State
        Apply(Event) Rollout
    }
    class Event {
        RolloutID, Seq
        Type, At, Payload
    }
    class EventStore {
        <<interface>>
        Append(Event) error
        Since(RolloutID, Seq) []Event
    }
    class Queue {
        Submit(Trigger) CompositionID
        single-flight, coalescing
    }
    class Composer {
        <<interface>>
        Compose(ctx, Inputs) Result
    }
    class Registry {
        <<interface>>
        FindRender(RenderKey)
        PushRender()
        MoveTag()
    }
    class Signer {
        <<interface>>
        Sign(Digest) Signature
    }
    class Cluster {
        <<interface>>
        DryRun(objects) []Diagnostic
        WatchRelease(Project)
    }
    Rollout --> "0..*" Event : folds
    Rollout ..> EventStore : persists through
    Queue --> Rollout : starts
    Queue ..> Composer
    Queue ..> Registry
    Queue ..> Signer
    Queue ..> Cluster
    classDef accent fill:#0000a1,stroke:#0000b1
    class EventStore:::accent
    class Composer:::accent
    class Registry:::accent
    class Signer:::accent
    class Cluster:::accent
