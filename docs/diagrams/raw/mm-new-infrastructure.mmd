%% title: New: Infrastructure Intent
classDiagram
    direction LR
    class InfrastructureIntent {
        labelPrefix: String
    }
    class Site {
        name: SiteName
        timezone: TimeZone
    }
    class HostNode {
        name: NodeName
        arch: Arch
        roles: HostRole [*]
        totals, reserve
        capabilities, taints
    }
    class MaintenanceWindow {
        start: LocalTime
        end: LocalTime
        days: Weekday [*]
    }
    class GpuSpec {
        vendor, model, class
        memoryMib: Int
    }
    class DiskSpec {
        media: Media
        usableGib: Int
    }
    InfrastructureIntent *-- "1..*" Site : sites
    Site *-- "1..*" HostNode : nodes
    Site *-- "1" MaintenanceWindow : window
    HostNode *-- "*" GpuSpec : gpus
    HostNode *-- "*" DiskSpec : disks
    HostNode *-- "0..1" MaintenanceWindow : window
    note for InfrastructureIntent "new: added by estate-kit"
