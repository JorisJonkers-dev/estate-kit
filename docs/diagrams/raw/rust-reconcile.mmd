%% title: Rust: the reconcile loop every component and the host applier share
classDiagram
    direction TB
    class Reconciler {
        <<trait>>
        type Desired
        type Observed
        type Action
        observe() Result#lt;Observed#gt;
        decide(Desired, Observed) Vec#lt;Action#gt;
        act(Action) Result
    }
    class Loop {
        tick(): observe, decide, act one step
        never deletes what it does not own
    }
