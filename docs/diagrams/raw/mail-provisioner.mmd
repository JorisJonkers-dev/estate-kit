%% title: Mailbox component: the driver and its ports
classDiagram
    direction TB
    class MailboxDriver {
        tick(Mailbox) Status: observe, decide, act one step
    }
    class MailboxSource {
        <<trait>>
        watch(LabelSelector)
    }
    class Stalwart {
        <<trait>>
        ensure_account(Mailbox) Result
        remove_account(Mailbox) Result
    }
    class Secrets {
        <<trait>>
        password(Mailbox) Result#lt;SecretRef#gt;
    }
    MailboxDriver ..> MailboxSource
    MailboxDriver ..> Stalwart
    MailboxDriver ..> Secrets
    classDef accent fill:#0000a1,stroke:#0000b1
    class MailboxSource:::accent
    class Stalwart:::accent
    class Secrets:::accent
