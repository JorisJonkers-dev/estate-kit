%% title: Mail provisioner: the reconciler and its ports
classDiagram
    direction TB
    class MailboxReconciler {
        reconcile(Mailbox) Status
    }
    class MailboxSource {
        <<trait>>
        watch(LabelSelector)
    }
    class Stalwart {
        <<trait>>
        ensure_account(Mailbox) Result
        remove_account(Mailbox) Result
    }
    class Secrets {
        <<trait>>
        password(Mailbox) Result#lt;SecretRef#gt;
    }
    MailboxReconciler ..> MailboxSource
    MailboxReconciler ..> Stalwart
    MailboxReconciler ..> Secrets
    classDef accent fill:#0000a1,stroke:#0000b1
    class MailboxSource:::accent
    class Stalwart:::accent
    class Secrets:::accent
