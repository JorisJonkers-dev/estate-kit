%% title: Host applier: one reconcile step and the ports it drives
classDiagram
    direction TB
    class Agent {
        node: NodeName
        step() one reconcile step
    }
    class PointerSource {
        <<trait>>
        current(NodeName) Result#lt;HostTag#gt;
    }
    class ClosureFetcher {
        <<trait>>
        fetch(StorePath) Result
    }
    class Lease {
        <<trait>>
        acquire() Result
        release() Result
    }
    class Evictor {
        <<trait>>
        drain(NodeName) Result
        uncordon(NodeName) Result
    }
    class Switcher {
        <<trait>>
        switch(Generation) Result
        needs_reboot(Generation) bool
    }
    class WindowPolicy {
        <<trait>>
        open(Timestamp) bool
    }
    Agent ..> PointerSource
    Agent ..> ClosureFetcher
    Agent ..> Lease
    Agent ..> Evictor
    Agent ..> Switcher
    Agent ..> WindowPolicy
    classDef accent fill:#0000a1,stroke:#0000b1
    class PointerSource:::accent
    class ClosureFetcher:::accent
    class Lease:::accent
    class Evictor:::accent
    class Switcher:::accent
    class WindowPolicy:::accent
